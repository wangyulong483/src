<root main_tree_to_execute="MainTree">
  <!--
  ============================================================================
  Behavior Tree: 阿克曼 + RPP 多路点导航专用 (NavigateThroughPoses)
  - 使用 ComputePathThroughPoses + RemovePassedGoals 处理多路点序列
  - RemovePassedGoals 标记已通过路点，每轮仅规划到下一个未完成路点
  - 彻底移除 Spin 恢复节点（阿克曼不可原地旋转）
  - ★ SmoothPath 已移除: Humble ConstrainedSmoother 已知 NaN 崩溃 (nav2#4755)
  - 系统级恢复: ClearCostmap → BackUp 0.8m → Wait 3s → BackUp 1.5m
  ============================================================================
  -->
  <BehaviorTree ID="MainTree">

    <RecoveryNode number_of_retries="-1" name="NavigateThroughPosesRecovery">

      <PipelineSequence name="NavigateThroughPosesWithReplanning">

        <!--
        第1级：全局重规划 @ 1.0Hz — 先移除已过路点再规划剩余路径
        RemovePassedGoals 放在 ComputePathThroughPoses 之前，确保 FollowPath
        失败后重规划时已过路点被正确清理，不会反复规划通过同一路点的完整路径。
        ★ 2026-07-07: 移除每周期 ClearEntireCostmap → 保留累积障碍 + heuristic缓存生效,
          仅在规划失败时(recovery分支)才清全局图 (照官方默认BT).
        -->
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <Sequence name="RemovePassedAndCompute">
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}"
                                 robot_base_frame="base_footprint" radius="0.4"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
            </Sequence>
            <Fallback name="ComputePathRecoveryFallback">
              <GoalUpdated/>
              <Sequence name="ClearGlobalAndWait">
                <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                    service_name="global_costmap/clear_entirely_global_costmap"/>
                <Wait wait_duration="0.5"/>
              </Sequence>
            </Fallback>
          </RecoveryNode>
        </RateController>

        <!--
        第2级：路径跟随
        -->
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Fallback name="FollowPathRecoveryFallback">
            <GoalUpdated/>
            <Sequence name="ClearCostmapAndWait">
              <ClearEntireCostmap name="ClearLocalCostmap-Context"
                                  service_name="local_costmap/clear_entirely_local_costmap"/>
              <Wait wait_duration="0.5"/>
            </Sequence>
          </Fallback>
        </RecoveryNode>

      </PipelineSequence>

      <!--
      系统级恢复行为 (RoundRobin 依次尝试)
      -->
      <Fallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearAndBackup">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
                                service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait wait_duration="0.5"/>
            <BackUp name="BackUpRecovery"
                    backup_dist="0.8"
                    backup_speed="0.12"/>
          </Sequence>
          <Wait wait_duration="3.0"/>
          <Sequence name="ClearAndBackupMore">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree2"
                                service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree2"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait wait_duration="0.5"/>
            <BackUp name="BackUpRecovery2"
                    backup_dist="1.5"
                    backup_speed="0.12"/>
          </Sequence>
        </RoundRobin>
      </Fallback>

    </RecoveryNode>

  </BehaviorTree>
</root>
